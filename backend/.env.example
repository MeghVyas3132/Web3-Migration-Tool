PORT=5000
NODE_ENV=development

# Supabase (Get from https://supabase.com → Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# JWT Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=
JWT_EXPIRE=30d

# Pinata IPFS (Get from https://pinata.cloud → API Keys)
# Option 1: Use API Key/Secret
PINATA_API_KEY=
PINATA_API_SECRET=
# Option 2: Use JWT (recommended)
PINATA_JWT=

# IPFS Gateway
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# File Upload
MAX_FILE_SIZE=104857600
UPLOAD_DIR=./uploads